---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta
			name="description"
			content="ホテル ローズマリの公式サイト。特別な客室、充実した設備、フードサービスをご案内します。"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>Hotel Rosemari | ふたりの時間を、もっと自由に。</title>
	</head>
	<body>
		<header class="site-header">
			<a class="logo" href="#top" aria-label="Hotel Rosemari トップへ">
				<span class="logo-small">HOTEL</span>
				<span class="logo-main">Rosemari</span>
				<span class="logo-ja">ホテル ローズマリ</span>
			</a>

			<nav class="desktop-nav" aria-label="メインナビゲーション">
				{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>

			<div class="header-actions">
				<a class="header-phone" href="tel:0000000000">
					<span>お問い合わせ</span>
					<strong>00-0000-0000</strong>
				</a>
				<a class="button button--small" href="#reserve">空室・予約</a>
				<button
					class="menu-button"
					type="button"
					aria-label="メニューを開く"
					aria-expanded="false"
					aria-controls="mobile-menu"
					data-menu-button
				>
					<span></span><span></span><span></span>
				</button>
			</div>

			<nav class="mobile-nav" id="mobile-menu" aria-label="モバイルナビゲーション" data-mobile-menu>
				{navItems.map((item) => <a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>)}
				<a class="mobile-nav__reserve" href="#reserve">空室・予約を見る</a>
			</nav>
		</header>

		<main>
			<section class="hero" id="top">
				<img
					class="hero__image"
					src={imageUrl('photo-1618773928121-c32242e63f39', 2200)}
					alt="やわらかな照明に包まれたホテルの客室"
					fetchpriority="high"
				/>
				<div class="hero__veil"></div>
				<div class="hero__content container">
					<div class="hero__copy">
						<p class="eyebrow">JUST THE TWO OF US</p>
						<h1><span class="hero__title-line">ふたりの時間を、</span><br /><em>もっと自由に。</em></h1>
						<p class="hero__lead">日常を少しだけ離れて。誰にも急かされない、<br />ふたりだけの心ほどける時間をお過ごしください。</p>

						<ul class="hero__points" aria-label="ホテルの特徴">
							<li>駅から車で3分</li>
							<li>駐車場60台</li>
							<li>24時間利用OK</li>
						</ul>

						<div class="hero__rates">
							<div><span>REST</span><strong>2,980<small>円〜</small></strong></div>
							<div><span>STAY</span><strong>6,480<small>円〜</small></strong></div>
						</div>

						<div class="hero__actions">
							<a class="button button--teal" href="#rooms">客室を見る</a>
							<a class="button" href="#price">料金を見る</a>
						</div>
					</div>
				</div>

				<a class="hero__scroll" href="#campaigns">
					<span>SCROLL</span>
					<i aria-hidden="true"></i>
				</a>
			</section>

			<section class="campaigns section section--compact" id="campaigns">
				<div class="container">
					<div class="campaigns__heading">
						<p class="eyebrow">SPECIAL OFFERS</p>
						<h2>今だけの、お得なお知らせ</h2>
					</div>
					<div class="campaign-grid">
						{campaigns.map((campaign) => (
							<article class={`campaign-card ${campaign.className}`}>
								<p>{campaign.kicker}</p>
								<h3>{campaign.title}</h3>
								<span>{campaign.text}</span>
							</article>
						))}
					</div>
				</div>
			</section>

			<section class="section concept" id="concept">
				<div class="container concept__inner">
					<div class="concept__visual reveal-image">
						<img
							src={imageUrl('photo-1566665797739-1674de7a421a')}
							alt="ピンクのアクセントが印象的な客室"
							loading="lazy"
						/>
						<div class="concept__image-label"><span>Private</span> &amp; Relax</div>
					</div>
					<div class="concept__copy">
						<div class="section-heading section-heading--left">
							<p class="eyebrow">CONCEPT</p>
							<h2>日常を忘れて、<br />ふたりだけの特別な時間を。</h2>
						</div>
						<p>ラグジュアリーでありながら、肩肘を張らずに過ごせる場所。ローズマリは、ふたりの距離が自然と近づく居心地を大切にしています。</p>
						<p>香り、光、肌ざわりまで丁寧に選び、客室ごとに異なる物語をご用意しました。今日の気分に合う一室を見つけてください。</p>
						<a class="text-link" href="#facilities">ホテルのこだわり <span>→</span></a>
					</div>
				</div>
			</section>

			<section class="section rooms" id="rooms">
				<div class="container">
					<div class="section-heading">
						<p class="eyebrow">ROOMS</p>
						<h2>お気に入りの一室を</h2>
						<p>色も、設えも、過ごし方も。個性の異なるお部屋からお選びください。</p>
					</div>

					<div class="room-grid">
						{rooms.map((room) => (
							<article class="room-card">
								<div class="room-card__image">
									<img src={room.image} alt={`${room.name}の客室`} loading="lazy" />
									<span>{room.rank}</span>
								</div>
								<div class="room-card__body">
									<div class="room-card__title">
										<div><span>ROOM {room.number}</span><h3>{room.name}</h3></div>
										<span class="room-card__arrow" aria-hidden="true">↗</span>
									</div>
									<ul>{room.tags.map((tag) => <li>{tag}</li>)}</ul>
									<div class="room-card__price">
										<p><span>休憩</span><strong>¥{room.rest}</strong>〜</p>
										<p><span>宿泊</span><strong>¥{room.stay}</strong>〜</p>
									</div>
								</div>
							</article>
						))}
					</div>
					<div class="center-action"><a class="button button--outline" href="#price">すべての料金を見る</a></div>
				</div>
			</section>

			<section class="section price" id="price">
				<div class="container container--narrow">
					<div class="section-heading">
						<p class="eyebrow">PRICE GUIDE</p>
						<h2>料金案内</h2>
						<p>わかりやすい料金で、思い立ったときに気軽に。</p>
					</div>

					<div class="price-panel">
						<div class="price-tabs" aria-label="料金区分">
							<span class="active">休憩</span><span>フリータイム</span><span>宿泊</span>
						</div>
						<div class="price-table-wrap">
							<table>
								<thead><tr><th>ご利用時間</th><th>平日</th><th>土日祝</th></tr></thead>
								<tbody>
									<tr><th>90分</th><td><strong>2,980</strong>円〜</td><td><strong>3,980</strong>円〜</td></tr>
									<tr><th>3時間</th><td><strong>3,980</strong>円〜</td><td><strong>5,280</strong>円〜</td></tr>
									<tr><th>5時間</th><td><strong>4,980</strong>円〜</td><td><strong>6,480</strong>円〜</td></tr>
								</tbody>
							</table>
						</div>
						<div class="price-panel__note">
							<span>MEMBER PRICE</span>
							<p>メンバー登録ですべての基本料金が<strong>5〜10% OFF</strong></p>
						</div>
					</div>
					<p class="fine-print">※表示価格は税込です。特別期間は料金が異なる場合があります。</p>
				</div>
			</section>

			<section class="section facilities" id="facilities">
				<div class="container">
					<div class="section-heading">
						<p class="eyebrow">FACILITIES &amp; SERVICE</p>
						<h2>設備・サービス</h2>
						<p>手ぶらで訪れても、いつものように寛げるものを揃えました。</p>
					</div>
					<div class="facility-grid">
						{facilities.map((facility, index) => (
							<article class="facility-card">
								<div class="facility-card__image">
									<img src={facility.image} alt={facility.title} loading="lazy" />
									<span>0{index + 1}</span>
								</div>
								<div><h3>{facility.title}</h3><p>{facility.text}</p></div>
							</article>
						))}
					</div>
					<div class="center-action"><a class="text-link" href="#reserve">詳しい設備を見る <span>→</span></a></div>
				</div>
			</section>

			<section class="section flow" id="flow">
				<div class="container">
					<div class="section-heading">
						<p class="eyebrow">HOW TO USE</p>
						<h2>ご利用の流れ</h2>
						<p>はじめての方にも、シンプルで分かりやすいシステムです。</p>
					</div>
					<ol class="flow-list">
						{flowSteps.map((step) => (
							<li>
								<span class="flow-list__number">{step.number}</span>
								<img class="flow-list__image" src={step.image} alt={step.imageAlt} loading="lazy" />
								<h3>{step.title}</h3>
								<p>{step.text}</p>
							</li>
						))}
					</ol>
				</div>
			</section>

			<section class="section food" id="food">
				<div class="container">
					<div class="section-heading">
						<p class="eyebrow">FOOD &amp; ROOM SERVICE</p>
						<h2>お部屋で楽しむ、とっておき</h2>
						<p>24時間いつでもオーダーOK。できたてをお部屋までお届けします。</p>
					</div>
					<div class="food-grid">
						{foods.map((food) => (
							<article class="food-card">
								<img src={food.image} alt={food.title} loading="lazy" />
								<div><span>ROOM SERVICE</span><h3>{food.title}</h3><p>{food.text}</p></div>
							</article>
						))}
					</div>
					<div class="center-action"><a class="button button--outline" href="#reserve">メニューを見る</a></div>
				</div>
			</section>

			<section class="section access" id="access">
				<div class="container container--narrow">
					<div class="section-heading">
						<p class="eyebrow">ACCESS</p>
						<h2>アクセス</h2>
						<p>街の近くで、日常から少しだけ離れた場所。</p>
					</div>
					<div class="access-card">
						<div class="access-card__map">
							<iframe
								src={mapEmbedUrl}
								title={`Hotel Rosemari周辺のGoogleマップ（${address}）`}
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								allowfullscreen
							></iframe>
						</div>
						<div class="access-card__info">
							<p class="access-card__name">HOTEL <strong>Rosemari</strong></p>
							<dl>
								<div><dt>住所</dt><dd>〒000-0000 ○○県○○市ローズ町3-5-3</dd></div>
								<div><dt>電話</dt><dd><a href="tel:0000000000">00-0000-0000</a></dd></div>
								<div><dt>車でのアクセス</dt><dd>○○ICより約3分</dd></div>
								<div><dt>駐車場</dt><dd>60台（ハイルーフ可）</dd></div>
							</dl>
							<a class="button button--teal" href={mapLinkUrl} target="_blank" rel="noreferrer">Googleマップで見る</a>
						</div>
					</div>
				</div>
			</section>

			<section class="section faq" id="faq">
				<div class="container container--narrow">
					<div class="section-heading">
						<p class="eyebrow">FREQUENTLY ASKED QUESTIONS</p>
						<h2>よくあるご質問</h2>
					</div>
					<div class="faq-list">
						{faqs.map((faq) => (
							<details>
								<summary><span>Q</span>{faq.question}<i aria-hidden="true"></i></summary>
								<div class="faq-list__answer"><span>A</span><p>{faq.answer}</p></div>
							</details>
						))}
					</div>
				</div>
			</section>

			<section class="closing" id="reserve">
				<div class="container closing__inner">
					<p class="eyebrow">A NIGHT JUST FOR TWO</p>
					<h2>今夜、ふたりだけの時間を。</h2>
					<div class="closing__facts">
						<span>休憩 <strong>2,980円〜</strong></span>
						<span>宿泊 <strong>6,480円〜</strong></span>
						<span>駐車場 <strong>60台</strong></span>
						<span>駅から車で <strong>3分</strong></span>
					</div>
					<div class="closing__actions">
						<a class="button button--white" href="#rooms">空室・予約を見る</a>
						<a class="button button--yellow" href="tel:0000000000">電話で問い合わせる</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container site-footer__main">
				<a class="logo logo--footer" href="#top">
					<span class="logo-small">HOTEL</span>
					<span class="logo-main">Rosemari</span>
					<span class="logo-ja">ホテル ローズマリ</span>
				</a>
				<nav aria-label="フッターナビゲーション">
					{navItems.map((item) => <a href={item.href}>{item.label}</a>)}
				</nav>
				<div class="site-footer__contact"><span>ご予約・お問い合わせ</span><a href="tel:0000000000">00-0000-0000</a></div>
			</div>
			<div class="container site-footer__bottom"><small>© 2026 HOTEL ROSEMARI</small><a href="#top">PAGE TOP ↑</a></div>
		</footer>

		<a class="mobile-reserve" href="#reserve"><span>空室確認・ご予約</span><strong>BOOK NOW</strong></a>

		<script>
			const menuButton = document.querySelector('[data-menu-button]');
			const mobileMenu = document.querySelector('[data-mobile-menu]');

			const closeMenu = () => {
				menuButton?.setAttribute('aria-expanded', 'false');
				mobileMenu?.classList.remove('is-open');
				document.body.classList.remove('menu-open');
			};

			menuButton?.addEventListener('click', () => {
				const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
				menuButton.setAttribute('aria-expanded', String(!isOpen));
				mobileMenu?.classList.toggle('is-open', !isOpen);
				document.body.classList.toggle('menu-open', !isOpen);
			});

			mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
			document.addEventListener('keydown', (event) => {
