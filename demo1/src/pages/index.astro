---
const imageUrl = (id: string, width = 1200) =>
	`https://images.unsplash.com/${id}?auto=format&fit=crop&w=${width}&q=85`;

const address = '〒000-0000 ○○県○○市ローズ町3-5-3';
const mapQuery = encodeURIComponent(address);
const mapEmbedUrl = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLinkUrl = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;

const navItems = [
	{ label: '客室', href: '#rooms' },
	{ label: '料金', href: '#price' },
	{ label: '設備・サービス', href: '#facilities' },
	{ label: 'フード', href: '#food' },
	{ label: 'アクセス', href: '#access' },
	{ label: 'FAQ', href: '#faq' },
];

const campaigns = [
	{
		kicker: '平日がお得',
		title: '宿泊料金 20% OFF',
		text: '月〜木曜日限定。いつもの時間を、もっとゆったり。',
		className: 'campaign-card--yellow',
	},
	{
		kicker: '今すぐ使える',
		title: '期間限定 500円 OFF',
		text: '公式サイトからのご予約限定クーポンです。',
		className: 'campaign-card--mint',
	},
	{
		kicker: 'メンバー様限定',
		title: 'ポイント 2倍',
		text: '貯めて、使えて、楽しみがもっと広がります。',
		className: 'campaign-card--pink',
	},
];

const rooms = [
	{
		name: 'Botanical Suite',
		number: '501',
		rank: 'Suite',
		image: imageUrl('photo-1611892440504-42a792e24d32'),
		tags: ['露天風呂', 'サウナ', 'キングベッド'],
		rest: '4,480',
		stay: '7,980',
	},
	{
		name: 'Blush Theater',
		number: '302',
		rank: 'Premier',
		image: imageUrl('photo-1591088398332-8a7791972843'),
		tags: ['大画面TV', 'VOD', 'バスジェット'],
		rest: '3,980',
		stay: '6,980',
	},
	{
		name: 'Natural Comfort',
		number: '205',
		rank: 'Deluxe',
		image: imageUrl('photo-1564501049412-61c2a3083791'),
		tags: ['マッサージチェア', '美容家電'],
		rest: '3,480',
		stay: '5,980',
	},
	{
		name: 'Rose Standard',
		number: '103',
		rank: 'Standard',
		image: imageUrl('photo-1590490360182-c33d57733427'),
		tags: ['大型TV', 'Wi-Fi', '冷蔵庫'],
		rest: '2,980',
		stay: '4,980',
	},
];

const facilities = [
	{
		title: 'バス・リラクゼーション',
		text: '広々とした浴室とジェットバスで、心までほどける時間を。',
		image: imageUrl('photo-1584622781564-1d987f7333c1'),
	},
	{
		title: 'シアター＆サウンド',
		text: '大型TVとVODを全室に。好きな作品を好きなだけ。',
		image: imageUrl('photo-1516280440614-37939bbacd81'),
	},
	{
		title: '客室設備',
		text: '電子レンジ、冷蔵庫、電気ケトルなどを完備。',
		image: imageUrl('photo-1570222094114-d054a817e56b'),
	},
	{
		title: 'アメニティ',
		text: 'スキンケアからヘアケアまで、選ぶ楽しさもご用意。',
		image: imageUrl('photo-1560066984-138dadb4c035'),
	},
];

const flowSteps = [
	{
		number: '01',
		title: 'ご来店',
		text: '駐車場に車を停め、そのままエントランスへ。',
		image: imageUrl('photo-1566073771259-6a8506099945', 640),
		imageAlt: 'ホテルのエントランスイメージ',
	},
	{
		number: '02',
		title: 'お部屋を選ぶ',
		text: 'ロビーのパネルからお好みのお部屋を選択。',
		image: imageUrl('photo-1564501049412-61c2a3083791', 640),
		imageAlt: 'お部屋選びのイメージ',
	},
	{
		number: '03',
		title: 'ご入室',
		text: '発行されたキーでお部屋へ。人目を気にせずスムーズ。',
		image: imageUrl('photo-1590490360182-c33d57733427', 640),
		imageAlt: 'ホテル客室のイメージ',
	},
	{
		number: '04',
		title: 'ご精算',
		text: 'お帰りの際に自動精算機でお支払いください。',
		image: imageUrl('photo-1556742049-0cfed4f6a45d', 640),
		imageAlt: 'キャッシュレス決済のイメージ',
	},
];

