---
import Layout from "../layouts/Layout.astro";

const plans = [
  {
    day: "平日（月〜木）",
    rows: [
      { plan: "休憩", time: "11:00〜24:00", price: "¥2,480〜¥6,200" },
      { plan: "サービスタイム（3〜5時間）", time: "時間帯による", price: "¥3,580〜¥7,000" },
      { plan: "宿泊", time: "21:00〜翌11:00", price: "¥5,500〜¥11,500" },
    ],
  },
  {
    day: "金曜・祝前日",
    rows: [
      { plan: "休憩", time: "11:00〜24:00", price: "¥2,480〜¥6,200" },
      { plan: "宿泊", time: "21:00〜翌11:00", price: "¥6,000〜¥12,000" },
    ],
  },
  {
    day: "土曜・祝日",
    rows: [
      { plan: "休憩", time: "11:00〜24:00", price: "¥2,680〜¥6,200" },
      { plan: "サービスタイム", time: "6:00〜12:00（3h）／12:00〜15:00（2h）", price: "お問い合わせください" },
      { plan: "宿泊", time: "22:00〜翌11:00", price: "¥6,600〜¥12,000" },
    ],
  },
  {
    day: "日曜・祝日明け",
    rows: [
      { plan: "休憩", time: "11:00〜24:00", price: "¥2,480〜¥6,200" },
      { plan: "宿泊", time: "21:00〜翌11:00", price: "¥6,000〜¥11,500" },
    ],
  },
];
---

<Layout
  title="料金のご案内｜ホテル レディシー【大阪・京橋】"
  description="ホテル レディシーの料金案内。休憩2,480円〜、宿泊5,500円〜、お得なサービスタイムもご用意。現金・各種クレジットカード対応。大阪・京橋駅徒歩5分。TEL 06-6352-0666"
  path="/price/"
>
  <div class="page-hero">
    <h1>料金のご案内</h1>
    <p>Price</p>
  </div>

  <section class="section">
    <div class="container">
      {plans.map((p) => (
        <div class="plan-block">
          <h2 class="plan-day">{p.day}</h2>
          <div class="table-scroll">
            <table class="price-table">
              <thead>
                <tr>
                  <th>プラン</th>
                  <th>時間</th>
                  <th>料金（ランクA〜I）</th>
                </tr>
              </thead>
              <tbody>
                {p.rows.map((row) => (
                  <tr>
                    <th>{row.plan}</th>
                    <td>{row.time}</td>
                    <td><strong>{row.price}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <div class="price-notes card">
        <h2>ご利用にあたって</h2>
        <ul>
          <li>料金はお部屋のランク（A〜I）により異なります。ランク別の詳細はお電話（<a href="tel:0663520666">06-6352-0666</a>）にてご確認ください。</li>
          <li>延長は15分毎 ¥840〜¥1,000です。</li>
          <li>お支払いは現金のほか、各種クレジットカードがご利用いただけます。</li>
          <li>ルームランクと部屋番号の対応は<a href="/rooms/">客室ページ</a>をご覧ください。</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .plan-block { margin-bottom: 40px; }

  .plan-day {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    color: var(--accent-strong);
    margin-bottom: 14px;
    padding-left: 14px;
    border-left: 3px solid var(--accent);
  }

  .price-notes {
    padding: 24px 22px;
    margin-top: 8px;
  }

  .price-notes h2 {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    color: var(--accent-strong);
    margin-bottom: 12px;
  }

  .price-notes li {
    position: relative;
    padding-left: 18px;
    font-size: 0.86rem;
    color: var(--text-dim);
    margin-bottom: 6px;
  }

  .price-notes li::before {
    content: "※";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .price-notes a {
    color: var(--accent-strong);
    text-decoration: underline;
  }
</style>
