---
import Base from '../layouts/Base.astro';
import {
  hotel,
  rooms,
  heroSlides,
  priceSummary,
  serviceTime,
  extension,
  amenities,
  yen,
} from '../data/hotel';

const restFrom = Math.min(...priceSummary.map((p) => p.rest.from));
const stayFrom = Math.min(...priceSummary.map((p) => p.stay.from));

const title = `${hotel.name} | 京橋駅すぐのラブホテル`;
const description = `${hotel.nearestStationWalk}。全室ジェットバス・レインシャワー完備。休憩${yen(restFrom)}〜、宿泊${yen(stayFrom)}〜。大阪・京橋のホテル レディシー。`;
---

<Base title={title} description={description}>
  {/* ------------------------------------------------------------------ HERO */}
  <section class="relative h-[100svh] min-h-[560px] w-full overflow-hidden">
    <div class="absolute inset-0">
      {
        heroSlides.map((src, i) => (
          <div class="slide absolute inset-0 overflow-hidden" style={`animation-delay:${i * 8}s`}>
            <img
              src={src}
              alt=""
              class="size-full object-cover"
              style={`animation-delay:${i * 8}s`}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          </div>
        ))
      }
    </div>

    {/* 写真を沈ませてコピーを立てる */}
    <div class="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/30 to-ink"></div>

    <div class="relative flex h-full items-center">
      <div class="mx-auto w-full max-w-7xl px-5 md:px-10">
        <p class="eyebrow">Kyobashi, Osaka</p>
        <h1 class="mt-6 font-serif text-[2.6rem] leading-[1.35] font-light tracking-wide md:text-6xl md:leading-[1.4]">
          京橋の夜に、<br />ふたりだけの余白を。
        </h1>
        <p class="mt-8 max-w-md text-sm leading-loose text-cream/75 md:text-base">
          {hotel.accessTrain}。<br class="hidden md:block" />
          全室にジェットバスとレインシャワー、1,000タイトル以上のVOD。
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="/room"
            class="border border-gold bg-gold px-8 py-4 text-sm tracking-[0.2em] text-ink transition-colors hover:bg-transparent hover:text-gold"
          >
            客室を見る
          </a>
          <a
            href="/price"
            class="border border-cream/30 px-8 py-4 text-sm tracking-[0.2em] text-cream transition-colors hover:border-gold hover:text-gold"
          >
            料金を見る
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 md:block">
      <span class="font-display text-[10px] tracking-[0.4em] text-cream/50">SCROLL</span>
    </div>
  </section>

  {/* ------------------------------------------------- 最重要情報を折り返し直後に */}
  <section class="border-y border-line bg-ink-soft">
    <div class="mx-auto grid max-w-7xl grid-cols-2 divide-x divide-line md:grid-cols-4 md:px-10">
      {
        [
          { k: '休憩', v: `${yen(restFrom)}〜`, sub: '1時間' },
          { k: '宿泊', v: `${yen(stayFrom)}〜`, sub: '21:00 IN' },
          { k: 'アクセス', v: '徒歩5分', sub: 'JR・京阪・大阪メトロ 京橋駅' },
          { k: '客室', v: `全${rooms.length}室`, sub: '全室ジェットバス' },
        ].map((item, i) => (
          <div class:list={['px-5 py-8 md:px-8 md:py-10', i < 2 && 'border-b border-line md:border-b-0']}>
            <p class="text-[11px] tracking-[0.25em] text-gold">{item.k}</p>
            <p class="mt-3 font-display text-2xl tracking-wider text-cream md:text-3xl">{item.v}</p>
            <p class="mt-2 text-[11px] leading-relaxed text-muted">{item.sub}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* --------------------------------------------------------------- CONCEPT */}
  <section class="mx-auto max-w-7xl px-5 py-24 md:px-10 md:py-36">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">Concept</p>
      <h2 class="mt-6 font-serif text-2xl leading-relaxed font-light md:text-4xl md:leading-[1.7]">
        帰りたくなくなる、<br />そんな部屋を。
      </h2>
      <div class="rule mx-auto mt-10 w-24"></div>
      <p class="mt-10 text-sm leading-loose text-muted md:text-base">
        大型ベッドとカウチソファ、円形の大きな浴室。<br class="hidden md:block" />
        岩盤浴とサウナを備えた部屋もご用意しています。<br class="hidden md:block" />
        京橋駅から歩いてすぐ、けれど街の喧騒からは切り離された時間を。
      </p>
    </div>
  </section>

  {/* ----------------------------------------------------------------- ROOMS */}
  <section class="bg-ink-soft py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-5 md:px-10">
      <div class="reveal flex items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Room</p>
          <h2 class="mt-4 font-serif text-2xl font-light md:text-4xl">客室</h2>
        </div>
        <a
          href="/room"
          class="shrink-0 border-b border-gold/40 pb-1 text-sm tracking-widest text-gold transition-colors hover:border-gold"
        >
          全ての客室
        </a>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 md:mt-16">
        {
          rooms.map((room, i) => (
            <a
              href={`/room#${room.no}`}
              class="reveal group relative block overflow-hidden bg-ink-card"
              style={`transition-delay:${(i % 3) * 90}ms`}
            >
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={room.images[0]}
                  alt={`${room.no}号室`}
                  loading="lazy"
                  class="size-full object-cover transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                />
              </div>
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink via-ink/70 to-transparent px-6 pt-16 pb-6">
                <div class="flex items-baseline justify-between">
                  <p class="font-display text-3xl tracking-widest text-cream">
                    {room.no}
                    <span class="ml-1 text-sm tracking-normal text-muted">号室</span>
                  </p>
                  {room.type && (
                    <span class="border border-gold/40 px-3 py-1 text-[10px] tracking-[0.2em] text-gold">
                      {room.type}
                    </span>
                  )}
                </div>
                {room.description && (
                  <p class="mt-3 line-clamp-2 text-xs leading-relaxed text-muted">{room.description}</p>
                )}
              </div>
            </a>
          ))
        }
      </div>

      {
        rooms.every((r) => !r.description) && (
          <p class="mt-8 text-center text-xs text-muted/70">
            ※ 各室の紹介文・タイプ・料金ランクは未設定です（src/data/hotel.ts）
          </p>
        )
      }
    </div>
  </section>

  {/* ----------------------------------------------------------------- PRICE */}
  <section class="mx-auto max-w-7xl px-5 py-24 md:px-10 md:py-32">
    <div class="reveal text-center">
      <p class="eyebrow">Price</p>
      <h2 class="mt-4 font-serif text-2xl font-light md:text-4xl">料金</h2>
    </div>

    <div class="reveal mt-12 overflow-x-auto md:mt-16">
      <table class="w-full min-w-[640px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-gold/30">
            <th class="px-4 py-4 text-left font-normal tracking-widest text-gold">区分</th>
            <th class="px-4 py-4 text-left font-normal tracking-widest text-gold">休憩</th>
            <th class="px-4 py-4 text-left font-normal tracking-widest text-gold">宿泊</th>
          </tr>
        </thead>
        <tbody>
          {
            priceSummary.map((row) => (
              <tr class="border-b border-line">
                <td class="px-4 py-6 align-top">
                  <p class="text-cream">{row.label}</p>
                  {row.note && <p class="mt-1 text-xs text-muted">{row.note}</p>}
                </td>
                <td class="px-4 py-6 align-top">
                  <p class="font-display text-xl tracking-wider text-cream">
                    {yen(row.rest.from)} <span class="text-sm text-muted">〜 {yen(row.rest.to)}</span>
                  </p>
                  <p class="mt-1 text-xs text-muted">{row.rest.time}</p>
                </td>
                <td class="px-4 py-6 align-top">
                  <p class="font-display text-xl tracking-wider text-cream">
                    {yen(row.stay.from)} <span class="text-sm text-muted">〜 {yen(row.stay.to)}</span>
                  </p>
                  <p class="mt-1 text-xs text-muted">{row.stay.time}</p>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="reveal mt-12 grid gap-5 md:grid-cols-3">
      <div class="border border-line bg-ink-card p-7">
        <p class="text-xs tracking-[0.25em] text-gold">サービスタイム / 平日</p>
        <dl class="mt-5 space-y-3">
          {
            serviceTime.weekday.map((s) => (
              <div class="flex justify-between gap-4 text-sm">
                <dt class="text-cream/90">{s.time}</dt>
                <dd class="shrink-0 text-muted">{s.duration}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="border border-line bg-ink-card p-7">
        <p class="text-xs tracking-[0.25em] text-gold">サービスタイム / 土日祝</p>
        <dl class="mt-5 space-y-3">
          {
            serviceTime.weekend.map((s) => (
              <div class="flex justify-between gap-4 text-sm">
                <dt class="text-cream/90">{s.time}</dt>
                <dd class="shrink-0 text-muted">{s.duration}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="border border-line bg-ink-card p-7">
        <p class="text-xs tracking-[0.25em] text-gold">延長・お支払い</p>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-cream/90">延長 {extension.unit}</dt>
            <dd class="shrink-0 text-muted">
              {yen(extension.from)}〜{yen(extension.to)}
            </dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-cream/90">お支払い</dt>
            <dd class="shrink-0 text-muted">現金・各種カード</dd>
          </div>
        </dl>
      </div>
    </div>

    <p class="mt-8 text-center text-xs leading-relaxed text-muted">
      料金は客室ランク（A〜I）により異なります。ランク別の詳しい料金は
      <a href="/price" class="border-b border-gold/40 text-gold">料金ページ</a>をご覧ください。
    </p>
  </section>

  {/* --------------------------------------------------------------- SERVICE */}
  <section class="bg-ink-soft py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-5 md:px-10">
      <div class="reveal text-center">
        <p class="eyebrow">Service &amp; Amenity</p>
        <h2 class="mt-4 font-serif text-2xl font-light md:text-4xl">設備・アメニティ</h2>
        <p class="mt-6 text-sm text-muted">全室共通でご用意しています</p>
      </div>

      <ul class="reveal mx-auto mt-12 grid max-w-4xl grid-cols-2 gap-px overflow-hidden border border-line bg-line sm:grid-cols-3 md:mt-16 md:grid-cols-4">
        {
          amenities.map((a) => (
            <li class="bg-ink-soft px-5 py-7 text-center">
              <p class="text-sm text-cream">{a.label}</p>
              {a.note && <p class="mt-1.5 text-[11px] text-gold/80">{a.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------------------------------------------------------------- ACCESS */}
  <section class="mx-auto max-w-7xl px-5 py-24 md:px-10 md:py-32">
    <div class="grid gap-14 md:grid-cols-2 md:gap-20">
      <div class="reveal">
        <p class="eyebrow">Access</p>
        <h2 class="mt-4 font-serif text-2xl font-light md:text-4xl">アクセス</h2>

        <dl class="mt-10 space-y-8">
          <div>
            <dt class="text-xs tracking-[0.25em] text-gold">所在地</dt>
            <dd class="mt-3 text-base leading-relaxed text-cream">{hotel.address}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-[0.25em] text-gold">電車でお越しの方</dt>
            <dd class="mt-3 text-sm leading-loose text-cream/90">{hotel.accessTrain}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-[0.25em] text-gold">お車でお越しの方</dt>
            <dd class="mt-3 text-sm leading-loose text-cream/90">
              {hotel.accessCar}
              {
                hotel.parking ? (
                  <span class="mt-2 block text-muted">{hotel.parking}</span>
                ) : (
                  <span class="mt-2 block text-muted/70">※ 駐車場情報は未設定です</span>
                )
              }
            </dd>
          </div>
          <div>
            <dt class="text-xs tracking-[0.25em] text-gold">お電話</dt>
            <dd class="mt-3">
              <a
                href={hotel.telHref}
                class="font-display text-3xl tracking-widest text-cream transition-colors hover:text-gold"
              >
                {hotel.tel}
              </a>
            </dd>
          </div>
        </dl>

        <a
          href={hotel.mapUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-10 inline-block border border-cream/30 px-8 py-4 text-sm tracking-[0.2em] transition-colors hover:border-gold hover:text-gold"
        >
          地図アプリで開く
        </a>
      </div>

      <div class="reveal">
        {/* TODO: Google Maps 埋め込み。外部読み込みのため実装時に同意/計測方針を確認 */}
        <div
          class="flex aspect-square w-full items-center justify-center border border-line bg-ink-card text-sm text-muted"
        >
          地図エリア（Google Maps 埋め込み予定）
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ COUPON CTA */}
  <section class="border-t border-line bg-ink-card">
    <div class="reveal mx-auto max-w-7xl px-5 py-20 text-center md:px-10 md:py-24">
      <p class="eyebrow">Coupon</p>
      <h2 class="mt-6 font-serif text-2xl leading-relaxed font-light md:text-3xl">
        お得なクーポンをご用意しています
      </h2>
      <a
        href="/coupon"
        class="mt-10 inline-block border border-gold bg-gold px-10 py-4 text-sm tracking-[0.2em] text-ink transition-colors hover:bg-transparent hover:text-gold"
      >
        クーポンを見る
      </a>
    </div>
  </section>
</Base>
